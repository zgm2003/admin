# Go API 监听地址；前面的冒号表示监听本机所有网卡的 16301 端口
HTTP_ADDR=:16301

# PostgreSQL 完整连接串；请替换为本机真实账号和密码
POSTGRES_DSN=host=127.0.0.1 user=your_user password=your_password dbname=admin port=5432 sslmode=disable TimeZone=Asia/Shanghai

# Redis 完整连接地址；最后的 0 表示使用 DB 0
REDIS_URL=redis://127.0.0.1:6379/0

# 唯一允许直接请求 Go API 的前端 Origin，不支持星号通配
CORS_ORIGIN=http://localhost:16300

# 应用唯一根密钥；至少 64 个随机 ASCII 字符，JWT 和 Refresh 子密钥由它派生
APP_SECRET=replace_with_at_least_64_random_characters_before_running_api_server

# Refresh Cookie 是否仅通过 HTTPS 发送；本地 HTTP 使用 0，HTTPS 使用 1
AUTH_COOKIE_SECURE=0
