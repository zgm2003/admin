# Load inside the http {} block, for example as conf.d/admin.conf.
# Replace HOST with the public hostname and TARGET with the absolute web/dist path.
# Use forward slashes in TARGET. Change proxy_pass when the API runs on another host.
map $http_upgrade $admin_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name HOST;
    root TARGET;
    index index.html;
    # Allow the existing 2 MiB XLSX import after base64 encoding and JSON wrapping.
    client_max_body_size 4m;

    location /api/ {
        # No trailing slash: preserve the complete /api/... request path.
        proxy_pass http://127.0.0.1:16301;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $admin_connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
